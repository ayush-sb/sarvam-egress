+#[cfg(test)]
+mod chunk_template_tests {
+    use super::*;
+    use crate::types::Annotated;
+    use axum::response::IntoResponse;
+    use axum::response::Sse;
+
+    type Chunk = NvCreateChatCompletionStreamResponse;
+
+    fn template(mode: TemplateMode) -> ChatChunkTemplate {
+        ChatChunkTemplate {
+            mode,
+            rendered: None,
+            scratch: Vec::new(),
+        }
+    }
+
+    fn chunk(value: serde_json::Value) -> Chunk {
+        serde_json::from_value(value).expect("valid chunk")
+    }
+
+    fn content_chunk(content: &str) -> Chunk {
+        chunk(serde_json::json!({
+            "id": "chatcmpl-x", "object": "chat.completion.chunk", "created": 7,
+            "model": "test-model",
+            "choices": [{"index": 0, "delta": {"content": content}}]
+        }))
+    }
+
+    fn serde(chunk: &Chunk) -> String {
+        serde_json::to_string(chunk).unwrap()
+    }
+
+    /// The bytes a client receives for one converted chunk.
+    async fn wire(event: Event) -> String {
+        let sse = Sse::new(futures::stream::once(async move {
+            Ok::<_, std::convert::Infallible>(event)
+        }));
+        let bytes = axum::body::to_bytes(sse.into_response().into_body(), usize::MAX)
+            .await
+            .unwrap();
+        String::from_utf8(bytes.to_vec()).unwrap()
+    }
+
+    #[test]
+    fn off_mode_never_renders() {
+        let mut t = template(TemplateMode::Off);
+        assert!(t.render(&content_chunk("hello")).is_none());
+        assert!(t.rendered.is_none());
+    }
+
+    #[test]
+    fn plain_chunks_match_serde_byte_for_byte() {
+        let contents = [
+            "hello",
+            "",
+            " ",
+            "a \"quoted\" word",
+            "back\\slash",
+            "line\nbreak\r\ttab",
+            "\u{0000}\u{0001}\u{001f}\u{007f}",
+            "ünïcödé 日本語 🙂",
+            "\u{2028}\u{2029}",
+            "</script>",
+            // Content that looks like the template's own split marker.
+            "\"delta\":{\"content\":\"x\"}",
+            "},\"finish_reason\":null",
+        ];
+        for mode in [TemplateMode::On, TemplateMode::Verify] {
+            let mut t = template(mode);
+            for content in contents {
+                let c = content_chunk(content);
+                let json = t.render(&c).expect("plain chunk renders").to_owned();
+                assert_eq!(json, serde(&c), "content {content:?} in {mode:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn first_chunk_is_also_templated_and_correct() {
+        let mut t = template(TemplateMode::On);
+        let c = content_chunk("first");
+        assert_eq!(t.render(&c).unwrap(), serde(&c));
+        assert!(t.rendered.is_some());
+    }
+
+    #[test]
+    fn non_plain_chunks_take_the_serde_path() {
+        let base = |delta: serde_json::Value, extra: serde_json::Value| {
+            let mut v = serde_json::json!({
+                "id": "chatcmpl-x", "object": "chat.completion.chunk", "created": 7,
+                "model": "test-model",
+                "choices": [{"index": 0, "delta": delta}]
+            });
+            for (k, val) in extra.as_object().unwrap() {
+                if k == "finish_reason" || k == "logprobs" {
+                    v["choices"][0][k] = val.clone();
+                } else {
+                    v[k] = val.clone();
+                }
+            }
+            chunk(v)
+        };
+        let none = serde_json::json!({});
+        let cases: Vec<(&str, Chunk)> = vec![
+            ("role", base(serde_json::json!({"role": "assistant", "content": "x"}), none.clone())),
+            ("no content", base(serde_json::json!({}), none.clone())),
+            ("reasoning", base(serde_json::json!({"content": "x", "reasoning_content": "r"}), none.clone())),
+            ("refusal", base(serde_json::json!({"content": "x", "refusal": "no"}), none.clone())),
+            (
+                "tool call",
+                base(
+                    serde_json::json!({"tool_calls": [{"index": 0, "id": "c", "type": "function",
+                        "function": {"name": "f", "arguments": "{}"}}]}),
+                    none.clone(),
+                ),
+            ),
+            ("finish_reason", base(serde_json::json!({"content": "x"}), serde_json::json!({"finish_reason": "stop"}))),
+            (
+                "logprobs",
+                base(serde_json::json!({"content": "x"}), serde_json::json!({"logprobs": {"content": []}})),
+            ),
+            (
+                "usage",
+                base(
+                    serde_json::json!({"content": "x"}),
+                    serde_json::json!({"usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}}),
+                ),
+            ),
+            ("system_fingerprint", base(serde_json::json!({"content": "x"}), serde_json::json!({"system_fingerprint": "fp"}))),
+            ("nvext", base(serde_json::json!({"content": "x"}), serde_json::json!({"nvext": {"k": 1}}))),
+        ];
+        for (name, c) in cases {
+            // Both before and after a template exists.
+            let mut fresh = template(TemplateMode::On);
+            assert!(fresh.render(&c).is_none(), "{name}: fresh template");
+            assert!(fresh.rendered.is_none(), "{name}: must not cut a template");
+            let mut warm = template(TemplateMode::On);
+            warm.render(&content_chunk("warm")).unwrap();
+            assert!(warm.render(&c).is_none(), "{name}: warm template");
+        }
+    }
+
+    #[test]
+    fn two_choices_take_the_serde_path() {
+        let c = chunk(serde_json::json!({
+            "id": "chatcmpl-x", "object": "chat.completion.chunk", "created": 7,
+            "model": "test-model",
+            "choices": [{"index": 0, "delta": {"content": "a"}}, {"index": 1, "delta": {"content": "b"}}]
+        }));
+        assert!(template(TemplateMode::On).render(&c).is_none());
+    }
+
+    #[test]
+    fn changed_envelope_falls_back_and_template_stays_valid() {
+        let mut t = template(TemplateMode::On);
+        let first = content_chunk("one");
+        t.render(&first).unwrap();
+
+        let mut other_id = content_chunk("two");
+        other_id.inner.id = "chatcmpl-y".to_string();
+        let mut other_model = content_chunk("two");
+        other_model.inner.model = "other".to_string();
+        let mut other_created = content_chunk("two");
+        other_created.inner.created = 8;
+        let mut other_index = content_chunk("two");
+        other_index.inner.choices[0].index = 1;
+        for c in [&other_id, &other_model, &other_created, &other_index] {
+            assert!(t.render(c).is_none());
+        }
+
+        // The stream's own chunks still render from the original template.
+        let next = content_chunk("three");
+        assert_eq!(t.render(&next).unwrap(), serde(&next));
+    }
+
+    #[test]
+    fn template_is_cut_from_the_first_plain_chunk_after_a_role_chunk() {
+        let mut t = template(TemplateMode::On);
+        let role = chunk(serde_json::json!({
+            "id": "chatcmpl-x", "object": "chat.completion.chunk", "created": 7,
+            "model": "test-model",
+            "choices": [{"index": 0, "delta": {"role": "assistant", "content": ""}}]
+        }));
+        assert!(t.render(&role).is_none());
+        let c = content_chunk("hi");
+        assert_eq!(t.render(&c).unwrap(), serde(&c));
+    }
+
+    #[test]
+    fn scratch_buffer_does_not_leak_between_chunks() {
+        let mut t = template(TemplateMode::On);
+        let long = content_chunk(&"x".repeat(4096));
+        assert_eq!(t.render(&long).unwrap(), serde(&long));
+        let short = content_chunk("y");
+        assert_eq!(t.render(&short).unwrap(), serde(&short));
+    }
+
+    /// End to end through the converter: the client bytes are the same with the template
+    /// on and off, including SSE comments.
+    #[tokio::test]
+    async fn converter_output_is_identical_with_and_without_template() {
+        let registry = Registry::new();
+        let metrics = Arc::new(Metrics::new());
+        metrics.register(&registry).unwrap();
+        let mut collector = metrics.clone().create_response_collector("test-model");
+        let mut guard = None;
+        let mut on = template(TemplateMode::On);
+
+        for (content, comment) in [
+            ("one", None),
+            ("two \"quoted\"\n", Some(vec!["t=1700000000000000000".to_string()])),
+            ("three", Some(vec!["multi\nline".to_string(), "second".to_string()])),
+        ] {
+            let annotated = || Annotated {
+                id: None,
+                data: Some(content_chunk(content)),
+                event: None,
+                comment: comment.clone(),
+                error: None,
+            };
+            let old = process_chat_response_using_event_converter_and_observe_metrics(
+                EventConverter::from(annotated()),
+                &mut collector,
+                &mut guard,
+                ReasoningField::ReasoningContent,
+            )
+            .unwrap()
+            .unwrap();
+            let new = process_chat_response_with_template(
+                EventConverter::from(annotated()),
+                &mut collector,
+                &mut guard,
+                ReasoningField::ReasoningContent,
+                &mut on,
+            )
+            .unwrap()
+            .unwrap();
+            assert_eq!(wire(new).await, wire(old).await, "content {content:?}");
+        }
+        assert!(on.rendered.is_some(), "the template path was taken");
+    }
+
+    #[tokio::test]
+    async fn non_default_reasoning_field_bypasses_the_template() {
+        let registry = Registry::new();
+        let metrics = Arc::new(Metrics::new());
+        metrics.register(&registry).unwrap();
+        let mut collector = metrics.clone().create_response_collector("test-model");
+        let mut guard = None;
+        let mut on = template(TemplateMode::On);
+        let annotated = Annotated {
+            id: None,
+            data: Some(content_chunk("x")),
+            event: None,
+            comment: None,
+            error: None,
+        };
+        let _event = process_chat_response_with_template(
+            EventConverter::from(annotated),
+            &mut collector,
+            &mut guard,
+            ReasoningField::Reasoning,
+            &mut on,
+        )
+        .unwrap()
+        .unwrap();
+        assert!(on.rendered.is_none());
+    }
+
+    #[tokio::test]
+    async fn events_and_errors_bypass_the_template() {
+        let registry = Registry::new();
+        let metrics = Arc::new(Metrics::new());
+        metrics.register(&registry).unwrap();
+        let mut collector = metrics.clone().create_response_collector("test-model");
+        let mut guard = None;
+        let mut on = template(TemplateMode::On);
+
+        let with_event = Annotated {
+            id: None,
+            data: Some(content_chunk("x")),
+            event: Some("custom".to_string()),
+            comment: None,
+            error: None,
+        };
+        let event = process_chat_response_with_template(
+            EventConverter::from(with_event),
+            &mut collector,
+            &mut guard,
+            ReasoningField::ReasoningContent,
+            &mut on,
+        )
+        .unwrap()
+        .unwrap();
+        assert!(wire(event).await.contains("event: custom"));
+        assert!(on.rendered.is_none(), "an event chunk must not use the template");
+
+        let error = Annotated::<Chunk> {
+            id: None,
+            data: None,
+            event: Some("error".to_string()),
+            comment: None,
+            error: None,
+        };
+        assert!(
+            process_chat_response_with_template(
+                EventConverter::from(error),
+                &mut collector,
+                &mut guard,
+                ReasoningField::ReasoningContent,
+                &mut on,
+            )
+            .is_err()
+        );
+    }
+}
