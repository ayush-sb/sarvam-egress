+/// How the per-stream SSE chunk template is used. Set once from `DYN_HTTP_SSE_TEMPLATE`:
+/// unset/other = off, `1` = on, `verify` = on, and every templated chunk is also serialised
+/// with serde and compared (a mismatch is logged and the serde output is sent).
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum TemplateMode {
+    Off,
+    On,
+    Verify,
+}
+
+fn sse_template_mode() -> TemplateMode {
+    static MODE: std::sync::OnceLock<TemplateMode> = std::sync::OnceLock::new();
+    *MODE.get_or_init(
+        || match std::env::var("DYN_HTTP_SSE_TEMPLATE").as_deref() {
+            Ok("1") | Ok("true") | Ok("on") => TemplateMode::On,
+            Ok("verify") => TemplateMode::Verify,
+            _ => TemplateMode::Off,
+        },
+    )
+}
+
+static TEMPLATE_HITS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static TEMPLATE_MISMATCHES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// The constant parts of one stream's content chunks, cut out of serde's own output.
+struct RenderedChunkTemplate {
+    // Values the template was cut for; a chunk that differs takes the serde path.
+    id: String,
+    model: String,
+    created: u32,
+    index: u32,
+    /// `{"id":"...","choices":[{"index":0,"delta":{"content":`
+    prefix: Vec<u8>,
+    /// `},"finish_reason":null,"logprobs":null}],"created":...,"model":"...","object":"..."}`
+    suffix: Vec<u8>,
+}
+
+/// Pre-rendered JSON for the plain content chunks of one chat stream.
+///
+/// Almost every chunk of a stream is the same JSON object with a different `content`
+/// string. The first such chunk is serialised with serde and split around its content;
+/// later ones are written as prefix + escaped content + suffix into a reused buffer, with
+/// no struct serialisation and no new `String`. Any chunk that is not a plain content
+/// chunk (role, finish_reason, usage, tool calls, nvext, ...) takes the serde path.
+pub struct ChatChunkTemplate {
+    mode: TemplateMode,
+    rendered: Option<RenderedChunkTemplate>,
+    scratch: Vec<u8>,
+}
+
+impl ChatChunkTemplate {
+    pub fn from_env() -> Self {
+        Self {
+            mode: sse_template_mode(),
+            rendered: None,
+            scratch: Vec::new(),
+        }
+    }
+
+    pub fn disabled() -> Self {
+        Self {
+            mode: TemplateMode::Off,
+            rendered: None,
+            scratch: Vec::new(),
+        }
+    }
+
+    /// The content text, if this chunk has the plain shape the template covers.
+    #[allow(deprecated)]
+    fn plain_content(chunk: &NvCreateChatCompletionStreamResponse) -> Option<&str> {
+        let inner = &chunk.inner;
+        if chunk.nvext.is_some()
+            || !chunk.tool_call_completion.is_empty()
+            || inner.usage.is_some()
+            || inner.service_tier.is_some()
+            || inner.system_fingerprint.is_some()
+            || inner.choices.len() != 1
+        {
+            return None;
+        }
+        let choice = &inner.choices[0];
+        if choice.finish_reason.is_some() || choice.logprobs.is_some() {
+            return None;
+        }
+        let delta = &choice.delta;
+        if delta.role.is_some()
+            || delta.tool_calls.is_some()
+            || delta.function_call.is_some()
+            || delta.refusal.is_some()
+            || delta.reasoning_content.is_some()
+        {
+            return None;
+        }
+        match &delta.content {
+            Some(dynamo_protocols::types::ChatCompletionMessageContent::Text(text)) => Some(text),
+            _ => None,
+        }
+    }
+
+    /// Serialise `chunk` once with serde and split the output around its content string.
+    fn cut(
+        chunk: &NvCreateChatCompletionStreamResponse,
+        content: &str,
+    ) -> Option<RenderedChunkTemplate> {
+        // Raw quotes cannot occur inside a JSON string, so this can only match the real key.
+        const NEEDLE: &str = "\"delta\":{\"content\":";
+        let json = serde_json::to_string(chunk).ok()?;
+        let escaped = serde_json::to_string(content).ok()?;
+        let start = json.find(NEEDLE)? + NEEDLE.len();
+        if !json[start..].starts_with(&escaped) {
+            return None;
+        }
+        Some(RenderedChunkTemplate {
+            id: chunk.inner.id.clone(),
+            model: chunk.inner.model.clone(),
+            created: chunk.inner.created,
+            index: chunk.inner.choices[0].index,
+            prefix: json.as_bytes()[..start].to_vec(),
+            suffix: json.as_bytes()[start + escaped.len()..].to_vec(),
+        })
+    }
+
+    /// The chunk's JSON from the template, or `None` when it must be serialised with serde.
+    fn render(&mut self, chunk: &NvCreateChatCompletionStreamResponse) -> Option<&str> {
+        if self.mode == TemplateMode::Off {
+            return None;
+        }
+        let content = Self::plain_content(chunk)?;
+        if self.rendered.is_none() {
+            self.rendered = Self::cut(chunk, content);
+        }
+        let rendered = self.rendered.as_ref()?;
+        let inner = &chunk.inner;
+        if inner.choices[0].index != rendered.index
+            || inner.created != rendered.created
+            || inner.id != rendered.id
+            || inner.model != rendered.model
+        {
+            return None;
+        }
+        self.scratch.clear();
+        self.scratch.extend_from_slice(&rendered.prefix);
+        // serde_json's own string escaping, appended in place.
+        serde_json::to_writer(&mut self.scratch, content).ok()?;
+        self.scratch.extend_from_slice(&rendered.suffix);
+        let json = std::str::from_utf8(&self.scratch).ok()?;
+        if self.mode == TemplateMode::Verify {
+            let expected = serde_json::to_string(chunk).ok()?;
+            if expected != json {
+                TEMPLATE_MISMATCHES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                tracing::error!(template = json, serde = %expected, "SSE template mismatch");
+                return None;
+            }
+            let hits = TEMPLATE_HITS.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1;
+            if hits % 50_000 == 0 {
+                tracing::info!(
+                    hits,
+                    mismatches = TEMPLATE_MISMATCHES.load(std::sync::atomic::Ordering::Relaxed),
+                    "SSE template verify"
+                );
+            }
+        }
+        Some(json)
+    }
+}
