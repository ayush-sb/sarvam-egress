+/// Benchmark experiments for the Tokio scheduler. Each one is off unless its variable is set.
+///
+/// - `DYN_RUNTIME_PIN_WORKERS=1`: pin worker thread i to the i-th CPU of the process affinity
+///   mask. Blocking-pool threads keep the whole mask.
+/// - `DYN_RUNTIME_EVENT_INTERVAL=N`: scheduler ticks between I/O driver polls (Tokio default 61).
+/// - `DYN_RUNTIME_GLOBAL_QUEUE_INTERVAL=N`: ticks between global queue checks.
+/// - `DYN_RUNTIME_DISABLE_LIFO_SLOT=1`: a woken task goes to the back of the local queue.
+fn apply_scheduler_experiments(builder: &mut tokio::runtime::Builder, worker_threads: usize) {
+    fn env_u32(name: &str) -> Option<u32> {
+        std::env::var(name).ok()?.trim().parse().ok().filter(|value| *value > 0)
+    }
+    if let Some(interval) = env_u32("DYN_RUNTIME_EVENT_INTERVAL") {
+        tracing::info!(interval, "Tokio event interval set (DYN_RUNTIME_EVENT_INTERVAL)");
+        builder.event_interval(interval);
+    }
+    if let Some(interval) = env_u32("DYN_RUNTIME_GLOBAL_QUEUE_INTERVAL") {
+        tracing::info!(
+            interval,
+            "Tokio global queue interval set (DYN_RUNTIME_GLOBAL_QUEUE_INTERVAL)"
+        );
+        builder.global_queue_interval(interval);
+    }
+    if env_is_truthy("DYN_RUNTIME_DISABLE_LIFO_SLOT") {
+        tracing::info!("Tokio LIFO slot disabled (DYN_RUNTIME_DISABLE_LIFO_SLOT)");
+        builder.disable_lifo_slot();
+    }
+    #[cfg(target_os = "linux")]
+    if env_is_truthy("DYN_RUNTIME_PIN_WORKERS") {
+        let cpus = worker_affinity::allowed_cpus();
+        if cpus.is_empty() {
+            tracing::warn!("DYN_RUNTIME_PIN_WORKERS set but the affinity mask is unreadable");
+        } else {
+            tracing::info!(?cpus, worker_threads, "Pinning Tokio workers (DYN_RUNTIME_PIN_WORKERS)");
+            // The runtime starts its workers first, so the first `worker_threads` thread starts
+            // of this builder are the workers. Later starts are blocking-pool threads.
+            let started = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+            builder.on_thread_start(move || {
+                let index = started.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                if index < worker_threads {
+                    worker_affinity::pin_current_thread(cpus[index % cpus.len()]);
+                }
+            });
+        }
+    }
+}
+
+#[cfg(target_os = "linux")]
+mod worker_affinity {
+    /// CPUs in this process's affinity mask, in ascending order.
+    pub(super) fn allowed_cpus() -> Vec<usize> {
+        // SAFETY: `set` is a plain bit set that the kernel fills; its size is passed exactly.
+        unsafe {
+            let mut set: libc::cpu_set_t = std::mem::zeroed();
+            if libc::sched_getaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &mut set) != 0 {
+                return Vec::new();
+            }
+            (0..libc::CPU_SETSIZE as usize)
+                .filter(|&cpu| libc::CPU_ISSET(cpu, &set))
+                .collect()
+        }
+    }
+
+    /// Restrict the calling thread to one CPU.
+    pub(super) fn pin_current_thread(cpu: usize) {
+        // SAFETY: as above; pid 0 is the calling thread.
+        let result = unsafe {
+            let mut set: libc::cpu_set_t = std::mem::zeroed();
+            libc::CPU_ZERO(&mut set);
+            libc::CPU_SET(cpu, &mut set);
+            libc::sched_setaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &set)
+        };
+        if result != 0 {
+            tracing::warn!(cpu, error = %std::io::Error::last_os_error(), "Could not pin a Tokio worker");
+        }
+    }
+}
