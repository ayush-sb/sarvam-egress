+/// `TraceLayer` replacement for inference routes (benchmark experiment, DYN_HTTP_TRACE_LITE=1).
+///
+/// Same span, same handler instrumentation and same "http response sent" log as the
+/// `TraceLayer` it replaces. The difference: `TraceLayer` enters the span on every body poll,
+/// which for streaming responses is once per SSE event. Here the body only holds the span, so it
+/// lives until the stream ends, and enters it once while the stream is dropped. Logs emitted
+/// while the body streams are not inside the request span.
+async fn trace_inference_request_lite(
+    request: axum::extract::Request,
+    next: axum::middleware::Next,
+) -> axum::response::Response {
+    use tracing::Instrument;
+    let span = make_inference_request_span(&request);
+    let start = std::time::Instant::now();
+    let response = next.run(request).instrument(span.clone()).await;
+    span.in_scope(|| {
+        let status = response.status();
+        let latency_ms = start.elapsed().as_millis();
+        if status.is_server_error() || status.is_client_error() {
+            tracing::error!(status = %status.as_u16(), latency_ms = %latency_ms, "http response sent");
+        } else {
+            tracing::info!(status = %status.as_u16(), latency_ms = %latency_ms, "http response sent");
+        }
+    });
+    let (parts, body) = response.into_parts();
+    let body = Body::from_stream(SpanHeldStream {
+        inner: Some(body.into_data_stream()),
+        span,
+    });
+    axum::response::Response::from_parts(parts, body)
+}
+
+/// Keeps a span alive for as long as the wrapped stream without entering it per item.
+struct SpanHeldStream<S> {
+    inner: Option<S>,
+    span: tracing::Span,
+}
+
+impl<S: futures::Stream + Unpin> futures::Stream for SpanHeldStream<S> {
+    type Item = S::Item;
+
+    fn poll_next(
+        mut self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Option<S::Item>> {
+        match self.inner.as_mut() {
+            Some(inner) => std::pin::Pin::new(inner).poll_next(cx),
+            None => std::task::Poll::Ready(None),
+        }
+    }
+}
+
+impl<S> Drop for SpanHeldStream<S> {
+    fn drop(&mut self) {
+        // Guards dropped with the stream (inflight, metrics) log inside the request span.
+        let _entered = self.span.enter();
+        drop(self.inner.take());
+    }
+}
