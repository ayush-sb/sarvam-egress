+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Optional HTTP/1 flat writes without replacing axum's connection lifecycle.
+//!
+//! Hyper 1.10 selects its Flatten strategy when the IO reports no vectored-write
+//! support. This changes buffering within one connection, not SSE events or flush
+//! timing. TLS uses a different server and is intentionally unaffected.
+
+use axum::serve::Listener;
+use std::{
+    io,
+    pin::Pin,
+    task::{Context, Poll},
+};
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+
+pub(super) struct WriteStrategyListener<L> {
+    pub inner: L,
+    pub flat: bool,
+}
+
+impl<L: Listener> Listener for WriteStrategyListener<L> {
+    type Io = WriteStrategyIo<L::Io>;
+    type Addr = L::Addr;
+
+    async fn accept(&mut self) -> (Self::Io, Self::Addr) {
+        let (inner, addr) = self.inner.accept().await;
+        (
+            WriteStrategyIo {
+                inner,
+                flat: self.flat,
+            },
+            addr,
+        )
+    }
+
+    fn local_addr(&self) -> io::Result<Self::Addr> {
+        self.inner.local_addr()
+    }
+}
+
+pub(super) struct WriteStrategyIo<T> {
+    inner: T,
+    flat: bool,
+}
+
+impl<T: AsyncRead + Unpin> AsyncRead for WriteStrategyIo<T> {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.inner).poll_read(cx, buf)
+    }
+}
+
+impl<T: AsyncWrite + Unpin> AsyncWrite for WriteStrategyIo<T> {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        Pin::new(&mut self.inner).poll_write(cx, buf)
+    }
+
+    fn poll_write_vectored(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        bufs: &[io::IoSlice<'_>],
+    ) -> Poll<io::Result<usize>> {
+        Pin::new(&mut self.inner).poll_write_vectored(cx, bufs)
+    }
+
+    fn is_write_vectored(&self) -> bool {
+        !self.flat && self.inner.is_write_vectored()
+    }
+
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.inner).poll_flush(cx)
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.inner).poll_shutdown(cx)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use axum::{
+        Router,
+        response::sse::{Event, Sse},
+        routing::get,
+    };
+    use std::{convert::Infallible, time::Duration};
+    use tokio::{
+        io::{AsyncReadExt, AsyncWriteExt},
+        net::{TcpListener, TcpStream},
+    };
+
+    #[tokio::test]
+    async fn flat_io_preserves_partial_writes_read_and_shutdown() {
+        for flat in [false, true] {
+            let (a, mut b) = tokio::io::duplex(7);
+            let inner_vectored = a.is_write_vectored();
+            let mut a = WriteStrategyIo { inner: a, flat };
+            assert_eq!(a.is_write_vectored(), !flat && inner_vectored);
+            let payload = "λ水\\\"\n".repeat(1000).into_bytes();
+            let expected = payload.clone();
+            let writer = tokio::spawn(async move {
+                a.write_all(&payload).await.unwrap();
+                a.flush().await.unwrap();
+                a.shutdown().await.unwrap();
+                let mut reply = Vec::new();
+                a.read_to_end(&mut reply).await.unwrap();
+                assert_eq!(reply, b"reply");
+            });
+            let mut received = Vec::new();
+            b.read_to_end(&mut received).await.unwrap();
+            assert_eq!(received, expected);
+            b.write_all(b"reply").await.unwrap();
+            b.shutdown().await.unwrap();
+            writer.await.unwrap();
+        }
+    }
+
+    #[tokio::test]
+    async fn flat_http_preserves_sse_order_comments_large_events_and_keepalive() {
+        let texts = vec![
+            "hello".to_owned(),
+            "λ水\\\"".repeat(12000),
+            "[DONE]".to_owned(),
+        ];
+        let expected: String = texts
+            .iter()
+            .map(|s| format!("data: {s}\n: stamp=123\n\n"))
+            .collect();
+        for flat in [false, true] {
+            let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let addr = listener.local_addr().unwrap();
+            let texts = texts.clone();
+            let router = Router::new().route(
+                "/",
+                get(move || {
+                    let events = texts.clone().into_iter().map(|s| {
+                        Ok::<_, Infallible>(Event::default().data(s).comment("stamp=123"))
+                    });
+                    async move { Sse::new(futures::stream::iter(events)) }
+                }),
+            );
+            let (stop, stopped) = tokio::sync::oneshot::channel();
+            let server = tokio::spawn(async move {
+                axum::serve(
+                    WriteStrategyListener {
+                        inner: listener,
+                        flat,
+                    },
+                    router,
+                )
+                .with_graceful_shutdown(async {
+                    let _ = stopped.await;
+                })
+                .await
+                .unwrap();
+            });
+            let mut socket = TcpStream::connect(addr).await.unwrap();
+            // Two pipelined requests exercise the same connection and HTTP framing.
+            socket.write_all(b"GET / HTTP/1.1\r\nHost: localhost\r\n\r\nGET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").await.unwrap();
+            let mut wire = Vec::new();
+            tokio::time::timeout(Duration::from_secs(5), socket.read_to_end(&mut wire))
+                .await
+                .unwrap()
+                .unwrap();
+            let mut cursor = 0;
+            for _ in 0..2 {
+                let header_end = wire[cursor..]
+                    .windows(4)
+                    .position(|w| w == b"\r\n\r\n")
+                    .unwrap()
+                    + cursor
+                    + 4;
+                assert!(wire[cursor..].starts_with(b"HTTP/1.1 200"));
+                cursor = header_end;
+                let mut body = Vec::new();
+                loop {
+                    let end = wire[cursor..]
+                        .windows(2)
+                        .position(|w| w == b"\r\n")
+                        .unwrap()
+                        + cursor;
+                    let len =
+                        usize::from_str_radix(std::str::from_utf8(&wire[cursor..end]).unwrap(), 16)
+                            .unwrap();
+                    cursor = end + 2;
+                    body.extend_from_slice(&wire[cursor..cursor + len]);
+                    cursor += len + 2;
+                    if len == 0 {
+                        break;
+                    }
+                }
+                assert_eq!(body, expected.as_bytes());
+            }
+            assert_eq!(cursor, wire.len());
+            stop.send(()).unwrap();
+            tokio::time::timeout(Duration::from_secs(5), server)
+                .await
+                .unwrap()
+                .unwrap();
+        }
+    }
+}
