# The published builds that ./setup.sh downloads (a GitHub release). Checksums: config/release.sha256.
# RELEASE_URL can point somewhere else (a mirror, or file:///path for a local test).
RELEASE_REPO=${RELEASE_REPO:-ayush-sb/sarvam-egress}
RELEASE_TAG=${RELEASE_TAG:-builds-dynamo-1.6.2-r2}
RELEASE_URL=${RELEASE_URL:-https://github.com/$RELEASE_REPO/releases/download/$RELEASE_TAG}
RELEASE_FILES="dynamo-1.6.2-vanilla.tar.zst dynamo-1.6.2-optimized.tar.zst"
