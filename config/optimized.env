# Runtime settings of the optimized frontend (the config recommendation).
# Most changes in the optimized library (patches/optimized/) do nothing until their flag below is set,
# so they can be switched off by deleting a line and restarting the frontend. Always on: the smaller
# stream items (fields boxed in patches 03 and 06 change struct layouts; behaviour and wire format are
# unchanged) and the ThinLTO + PGO build. Reverting those means running the stock library (one restart).
# Sourced by bash; FRONTEND_ENV is the space-separated list passed to the frontend process.
OPTIMIZED_FLAGS=(
    "LD_PRELOAD=${BUNDLE_JEMALLOC:-/usr/lib/x86_64-linux-gnu/libjemalloc.so.2}"  # jemalloc allocator
    DYN_HTTP_SSE_TEMPLATE=1              # prepared JSON template for plain text chunks (02)
    DYN_MIGRATION_BOX_STATE=1            # migration state behind a pointer (03)
    DYN_HTTP_TCP_NODELAY=1               # no Nagle delay on client sockets (01)
    DYN_HTTP_FLAT_WRITES=1               # one contiguous buffer per SSE event (04)
    DYN_TOKENIZER=basetenkenizer         # faster detokenizer, already in Dynamo 1.6.2
    DYN_TOKENIZER_FALLBACK=0
    DYN_SKIP_PLAIN_CHAT_POSTPROCESSING=1 # skip post-processing for plain chat requests (05)
    # One Tokio worker (a setting Dynamo already has; its default is one per core). One SGLang worker
    # sends at most about 10k events/s; at that rate a second worker mostly sleeps and wakes again.
    # Use two from about 30k events/s (the local mock test at 41k events/s needed two for latency).
    DYN_RUNTIME_NUM_WORKER_THREADS=1
    DYN_RUNTIME_DISABLE_LIFO_SLOT=1      # Tokio LIFO slot off (07)
)
FRONTEND_ENV="${OPTIMIZED_FLAGS[*]}"
