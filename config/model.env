# Model and engine settings for the GPU benchmark (tested on one RTX PRO 6000 Blackwell, 96 GB).
# The frontend changes are model-agnostic; this model is in the class the brief asks for.
# Every value can be overridden from the environment.
MODEL=${MODEL:-Qwen/Qwen3-30B-A3B-Instruct-2507-FP8}
MODEL_REVISION=${MODEL_REVISION:-5a5a776300a41aaa681dd7ff0106608ef2bc90db}
# FP8 weights with an NVFP4 KV cache need a Blackwell GPU. The runner adds --max-running-requests
# for the highest level, --stream-interval 1 and --disable-radix-cache.
SGLANG_ARGS=${SGLANG_ARGS:-"--mem-fraction-static 0.88 --kv-cache-dtype nvfp4 --context-length 2048"}
# Dynamo worker only: freeze Python GC after start-up (GC pauses in the worker stall delivery).
SGLANG_WORKER_ARGS=${SGLANG_WORKER_ARGS:-"--freeze-gc-after-init"}
MODEL_PATH=${MODEL_PATH:-${HF_HOME:-$HOME/.cache/huggingface}/hub/models--${MODEL//\//--}/snapshots/$MODEL_REVISION}
