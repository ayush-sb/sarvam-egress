# Mock mode (./setup.sh --mock, ./bench.sh --mock): Dynamo's mock engine in place of SGLang, no GPU.
# The mocker and the frontend need a tokenizer for the model name; no weights are loaded.
# Every value can be overridden from the environment.
MODEL=${MODEL:-Qwen/Qwen3-0.6B}
MODEL_REVISION=${MODEL_REVISION:-c1899de289a04d12100db370d81485cdf75e47ca}
MODEL_PATH=${MODEL_PATH:-${HF_HOME:-$HOME/.cache/huggingface}/hub/models--${MODEL//\//--}/snapshots/$MODEL_REVISION}
# Fixed engine step: every stream gets one token every 50 ms, one token per SSE event.
MOCKER_CONFIG=${MOCKER_CONFIG:-config/mocker-fixed.json}
# Each request asks for OUTPUT_TOKENS +- OUTPUT_SPREAD tokens (the load generator picks the length).
OUTPUT_TOKENS=${OUTPUT_TOKENS:-1024}
OUTPUT_SPREAD=${OUTPUT_SPREAD:-300}
# Tokio workers for the optimized frontend. The cloud preset (config/optimized.env) uses one at about 9000
# events/s; at the mock engine's 41000 events/s one worker raises client p99, and two work best.
OPTIMIZED_WORKER_THREADS=${OPTIMIZED_WORKER_THREADS:-2}
